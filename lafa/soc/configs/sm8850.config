# HakiOS fragment: the sm8850 family -- what is true of the SoC, whatever phone it is in.
#
# Nothing of this family's has been brought up on a phone yet: this file is where each fact goes once it is
# read from a device tree of the family (docs/porting/index.md, step 1, and `tools/soc-args.py` for soc.args).
CONFIG_SOC="sm8850"

# Eight cores. Which one is the boot CPU and how they clock is a fact of this chip, but the numbers below are
# the shape every Qualcomm phone of the last few generations uses, so they are the ones to try first; a first
# bring-up may also start with one core (leave these out) and turn the rest on with the CPUFREQ driver.
# CONFIG_CPUS=8
# CONFIG_BOOTCPU=7

# The family's drivers, each turned on when it has been made to work on this phone (step 3 of the port):
# CONFIG_CPUFREQ=y
# CONFIG_SOCINFO=y
# CONFIG_THERMAL=y
# CONFIG_HAKIOS_CPUFREQ=y
# CONFIG_HAKIOS_SOCINFO=y
# CONFIG_HAKIOS_THERMAL=y
# CONFIG_HAKIOS_PMIC=y
