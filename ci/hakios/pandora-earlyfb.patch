+static void
+earlyfb_glyph(char c)
+{
+	const unsigned char *g;
+	uint32_t px = earlyfb_col * 8, py = earlyfb_row * 16;
+
+	if (c < 32 || c > 126) {
+		c = '?';
+	}
+	g = earlyfb_font[(unsigned)c - 32];
+	for (uint32_t row = 0; row < 16; row++) {
+		uint32_t bits = g[row];
+		volatile uint32_t *line = earlyfb_fb + (py + row) * (EARLYFB_STRIDE / 4) + px;
+		for (uint32_t bit = 0; bit < 8; bit++) {
+			line[bit] = (bits & (0x80u >> bit)) ? 0x00ffffffu : 0x00000000u;
+		}
+	}
+}
+
+void
+earlyfb_putc(char c)
+{
+	if (!earlyfb_ready) {
+		return;
+	}
+	if (c == '\n') {
+		earlyfb_col = 0;
+		earlyfb_row++;
+	} else if (c == '\r') {
+		earlyfb_col = 0;
+	} else {
+		earlyfb_glyph(c);
+		if (++earlyfb_col >= EARLYFB_COLS) {
+			earlyfb_col = 0;
+			earlyfb_row++;
+		}
+	}
+	if (earlyfb_row >= EARLYFB_ROWS) {          /* scroll: move the lines up 16 pixels */
+		volatile uint32_t *fb = earlyfb_fb;
+		for (uint32_t y = 0; y < (EARLYFB_ROWS - 1) * 16; y++) {
+			for (uint32_t x = 0; x < EARLYFB_W; x++) {
+				fb[y * (EARLYFB_STRIDE / 4) + x] = fb[(y + 16) * (EARLYFB_STRIDE / 4) + x];
+			}
+		}
+		for (uint32_t y = (EARLYFB_ROWS - 1) * 16; y < EARLYFB_ROWS * 16; y++) {
+			for (uint32_t x = 0; x < EARLYFB_W; x++) {
+				fb[y * (EARLYFB_STRIDE / 4) + x] = 0;
+			}
+		}
+		earlyfb_row = EARLYFB_ROWS - 1;
+	}
+}
+
+void
+earlyfb_puts(const char *s)
+{
+	while (*s) {
+		earlyfb_putc(*s++);
+	}
+}
+
+/* "<tag> 0x<value>\n", for the milestones that carry one */
+void
+earlyfb_kv(const char *tag, uint64_t value)
+{
+	static const char hex[] = "0123456789abcdef";
+	char buf[17];
+	int i = 16;
+
+	buf[16] = 0;
+	do {
+		buf[--i] = hex[value & 0xf];
+		value >>= 4;
+	} while (value != 0 && i > 0);
+	earlyfb_puts(tag);
+	earlyfb_putc(' ');
+	earlyfb_putc('0');
+	earlyfb_putc('x');
+	earlyfb_puts(buf + i);
+	earlyfb_putc('\n');
+}
