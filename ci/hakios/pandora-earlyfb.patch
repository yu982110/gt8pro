+void
+earlyfb_init(void)
+{
+	earlyfb_fb = (volatile uint32_t *)(uintptr_t)EARLYFB_PA;
+	earlyfb_col = earlyfb_row = 0;
+	earlyfb_ready = 1;
+	for (uint32_t y = 0; y < EARLYFB_ROWS; y++) {
+		for (uint32_t x = 0; x < EARLYFB_W; x++) {
+			earlyfb_fb[y * 16 * (EARLYFB_STRIDE / 4) + x] = 0;
+		}
+	}
+}
